# Plantilla de configuracion del backend. NOMBRES, nunca valores reales:
# el repo es publico. Copiar a .env (ignorado) y completar.
# El servicio lee solo del entorno: dev.sh exporta este archivo.

# Obligatorias
DATABASE_URL=postgres://postgres:dev@localhost:55443/pae_dev?sslmode=disable
CORS_ORIGENES=http://localhost:3000

# Opcionales (valor por defecto entre parentesis)
# PORT=8080
# SESION_INACTIVIDAD=720h
# CONFIAR_PROXY=true
